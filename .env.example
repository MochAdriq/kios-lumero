# =========================================================
#  .env.example — Template Konfigurasi
# =========================================================
#  Copy file ini menjadi .env dan sesuaikan nilainya:
#    - Untuk LOCAL  : gunakan credential database lokal (XAMPP)
#    - Untuk SERVER : gunakan credential dari panel hosting
# =========================================================

# App Environment: local / production
APP_ENV=local
APP_NAME=SIM Resto Sempurna
APP_COMPANY=PT. Lokapedia Sukses Bersama
APP_TIMEZONE=Asia/Jakarta

# Base URL aplikasi (tanpa trailing slash)
# Local  : http://localhost/dcc
# Server : https://yourdomain.com/dcc  (atau https://yourdomain.com jika di root)
APP_URL=http://localhost/dcc
APP_DEBUG=true

DEFAULT_OUTLET_ID=1

# Database
# Local  : host=127.0.0.1, user=root, password=(kosong)
# Server : sesuaikan dengan panel hosting
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u643003184_lokapedia
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Branch Configuration
BRANCH_MAIN_NAME=Pasekon
BRANCH_MAIN_OUTLET_CODE=DCP
BRANCH_KB_NAME=Kalibunder
BRANCH_KB_OUTLET_ID=2
BRANCH_KB_OUTLET_CODE=KB

# Optional: dynamic branches in JSON
# APP_BRANCHES_JSON={"tg":{"name":"Tegal","outlet_id":3,"outlet_code":"TG"}}

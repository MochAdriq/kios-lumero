<IfModule mod_rewrite.c>
    RewriteEngine On

    # RewriteBase otomatis: tidak perlu hard-code path.
    # Apache akan mendeteksi base directory sendiri.

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^$ index.php [L]
    RewriteRule ^(.+)$ index.php?route=$1 [QSA,L]
</IfModule>

# Blokir akses ke file sensitif
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
